{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maziarkhaliliymcmb-hub/M666/blob/main/schemas/m666-runtime-contract.schema.json",
  "title": "M666 and 36OS runtime API contract",
  "$defs": {
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gene_a", "gene_b", "relation_type", "weight", "confidence"],
      "properties": {
        "gene_a": {"type": "integer", "minimum": 0, "maximum": 35},
        "gene_b": {"type": "integer", "minimum": 0, "maximum": 35},
        "relation_type": {
          "enum": ["synergy", "dependency", "conflict", "inhibition", "regulation", "complementarity", "neutral"]
        },
        "weight": {"type": "number", "minimum": -1, "maximum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "status": {"type": "string", "minLength": 1}
      }
    },
    "m666ReadResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standard", "version", "capacity", "active_count", "relations"],
      "properties": {
        "standard": {"const": "M666"},
        "version": {"const": "1.0.0"},
        "capacity": {"const": 666},
        "active_count": {"type": "integer", "minimum": 0, "maximum": 666},
        "relations": {
          "type": "array",
          "maxItems": 666,
          "items": {"$ref": "#/$defs/relation"}
        }
      }
    },
    "m666ProposalRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal_id", "proposal_type", "payload", "rationale", "evidence_refs", "change_level"],
      "properties": {
        "proposal_id": {"type": "string", "pattern": "^GP-[0-9]{8}-[0-9]{3,}$"},
        "proposal_type": {"const": "m666_relation"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gene_a", "gene_b", "relation_type", "weight", "confidence"],
          "properties": {
            "gene_a": {"type": "integer", "minimum": 0, "maximum": 35},
            "gene_b": {"type": "integer", "minimum": 0, "maximum": 35},
            "relation_type": {
              "enum": ["synergy", "dependency", "conflict", "inhibition", "regulation", "complementarity", "neutral"]
            },
            "weight": {"type": "number", "minimum": -1, "maximum": 1},
            "confidence": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "rationale": {"type": "string", "minLength": 20, "maxLength": 8000},
        "evidence_refs": {
          "type": "array",
          "maxItems": 50,
          "items": {"type": "string", "minLength": 1}
        },
        "change_level": {"enum": ["L1", "L2", "L3"]}
      }
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/m666ReadResponse"},
    {"$ref": "#/$defs/m666ProposalRequest"}
  ]
}
