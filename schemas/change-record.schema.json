{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "36OS Change Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "change_id",
    "date",
    "actor",
    "summary",
    "rationale",
    "goal_ids",
    "decision_ids",
    "risk",
    "approval_status",
    "touched_files"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "change_id": {
      "type": "string",
      "pattern": "^CHG-[0-9]{8}-[0-9]{3,}$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "actor": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 10
    },
    "rationale": {
      "type": "string",
      "minLength": 10
    },
    "goal_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^G-[0-9]{3,}$"
      }
    },
    "decision_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^D-[0-9]{3,}$"
      }
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "approval_status": {
      "type": "string"
    },
    "touched_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
